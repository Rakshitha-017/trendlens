# TrendLens environment configuration.
# Copy this file to `.env` (project root) and fill in values.
# `config.py` loads `.env` automatically and never overrides real env vars.

# --- LLM writing layer (OPTIONAL — disabled unless provider is set) ---
# provider: "gemini" | "openai" | "ollama"
TRENDLENS_LLM_PROVIDER=gemini
TRENDLENS_LLM_API_KEY=
TRENDLENS_LLM_MODEL=gemini-3.5-flash
TRENDLENS_LLM_BASE_URL=

# --- Live trend source (TRENDLENS_LIVE_SOURCE) ---
#   auto      → try Reddit first, fall back to Wikimedia Commons (key-free)
#   reddit    → Reddit only (needs unblocked network or OAuth creds)
#   wikimedia → Wikimedia Commons only (key-free, real timestamps, no engagement)
TRENDLENS_LIVE_SOURCE=auto

# Reddit (only needed if you want real upvote/comment engagement).
# Create an app at https://www.reddit.com/prefs/apps (script type).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TRENDLENS_SUBREDDITS=

# Wikimedia Commons (key-free fallback source)
TRENDLENS_WIKIMEDIA_QUERIES=latte art,coffee,street food,breakfast
TRENDLENS_WIKIMEDIA_LIMIT=10
TRENDLENS_WIKIMEDIA_DAYS=90
TRENDLENS_WIKIMEDIA_RECENT_DAYS=30

# API server
TRENDLENS_API_HOST=0.0.0.0
TRENDLENS_API_PORT=8000
