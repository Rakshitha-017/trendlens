# TrendLens Frontend — Environment Configuration (all optional)
# Copy to `.env` only if you need to override the defaults below.

# Python backend to proxy /api/* to (defaults: host 127.0.0.1, port 8000)
TRENDLENS_API_HOST="127.0.0.1"
TRENDLENS_API_PORT="8000"

# Port for the Express server itself (defaults to 3000)
PORT="3000"
